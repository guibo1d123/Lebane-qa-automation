{
  "name": "lebane-qa-automation",
  "version": "1.0.0",
  "description": "Automatización E2E de la funcionalidad Lista de precios de unidades (Lebane) con Playwright",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://tst.lebane.app"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "xlsx": "^0.18.5"
  }
}
